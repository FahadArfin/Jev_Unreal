# Documentation only: the server does not implicitly load .env files.
# Prefer scripts/Set-OpenRouterKey.ps1 and scripts/Start-Mcp.ps1 on Windows.
# Never commit a real API key or bridge token.
OPENROUTER_API_KEY=replace-with-your-local-openrouter-key
JEV_BRIDGE_TOKEN_FILE=C:\Users\YOUR_USER\AppData\Local\JevUnreal\bridge-token.txt
JEV_EXPECTED_PROJECT=C:\Projects\YourUnrealProject\YourUnrealProject.uproject
# Optional: explicitly configured local MCP servers for read-only tool discovery.
# Put machine-specific catalog configuration under ignored .local/.
JEV_CATALOG_FILE=C:\Projects\Jev_Unreal\.local\catalog.json
